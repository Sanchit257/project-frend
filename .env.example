# Copy to .env and fill in. .env is git-ignored; never commit your keys.
ANTHROPIC_API_KEY=

# Cartesia Sonic voice (https://play.cartesia.ai -> API keys / voices)
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL_ID=sonic-3.6

# Runpod Serverless vLLM endpoint serving Qwen/Qwen2.5-VL-7B-Instruct
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# Elastic Cloud: set either the Cloud ID or the endpoint URL
ELASTIC_CLOUD_ID=
ELASTIC_URL=
ELASTIC_API_KEY=

# Optional overrides (see config.py for all of them)
# FREND_CLAUDE_MODEL=claude-haiku-5-5
# FREND_TTS_ENGINE=auto
# FREND_CARTESIA_SPEED=1.1
# FREND_ELASTIC_INDEX=frend-memory
# FREND_DETECTOR_MAX_FPS=8
